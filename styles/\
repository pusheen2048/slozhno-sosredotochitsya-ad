:root {
  --font-family: "IBM Plex Mono", monospace;
  --font-size-base: 18px;
  --line-height-base: 1.3;
  --font-weight-regular: 400;
  --font-weight-bold: 700;

  --page-bg-color: #000028;
  --page-bg-image: url("../images/cover-image-dark.png");
  --text-color: #f1b2ce;
  --accent-color: #ff0070;
  --heading-color: #db00ff;
  --heading-shadow-color: #ff0070;
  --title-decor-bg: #ff0070;
  --title-decor-text: #000028;
  --section-heading-color: #ff0070;
  --decor-color: #ff0070;
  --button-hover-border: rgb(255 0 112 / 0.4);
  --rec-display: flex;

  --layout-padding: 10px;
  --main-vertical-padding: 40px;
  --sections-gap: 50px;
  --cards-gap: 20px;
}

@media (width >= 768px) {
  :root {
    --layout-padding: 20px;
    --main-vertical-padding: 60px;
    --sections-gap: 80px;
  }
}

